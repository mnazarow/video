# CorpVideo — файл конфигурации (.env). Создаётся автоматически скриптом install.sh.
# Docker: используется docker-compose.yml и контейнерами. Нативная установка: /etc/corpvideo/corpvideo.env.

# --- Общие ---
NODE_ENV=production
BASE_URL=https://video.example.com
DOMAIN=video.example.com
SECRET_KEY=замените-на-длинную-случайную-строку
LOG_LEVEL=info

# --- База данных ---
DB_PASSWORD=пароль-базы-данных
# Нативная установка: строка подключения целиком
# DATABASE_URL=postgres://corpvideo:пароль@127.0.0.1:5432/corpvideo

# --- Каталоги (нативная установка) ---
DATA_DIR=/var/lib/corpvideo

# --- Сервер приложения (нативная установка) ---
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true
WORKER_CONCURRENCY=2
# FFMPEG_PATH=ffmpeg
# FFMPEG_THREADS=0

# --- Трансляции (MediaMTX) ---
MEDIAMTX_VERSION=1.9.3
MEDIAMTX_HOOK_SECRET=секрет-для-хуков
# Публичные адреса, которые видят авторы трансляций:
LIVE_RTMP_URL=rtmp://video.example.com:1935
LIVE_SRT_URL=srt://video.example.com:8890
LIVE_WHIP_URL=https://video.example.com/whip

# --- Docker ---
# Режим HTTPS: none | letsencrypt | selfsigned | custom
SSL_MODE=none
HTTP_PORT=80
HTTPS_PORT=443
CORPVIDEO_VERSION=1.3.0
