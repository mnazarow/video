{
  "name": "corpvideo-server",
  "version": "1.10.5",
  "description": "CorpVideo — корпоративный видеохостинг: API-сервер и воркер обработки видео",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
