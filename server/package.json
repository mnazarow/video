    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "ldapts": "^8.0.5",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.1"
  }
}
